{
  "name": "pi-chrome-cdp",
  "version": "2.15.0",
  "description": "Give your AI agent access to your live Chrome session — works out of the box, connects to tabs you already have open",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "skills",
    "chrome",
    "cdp",
    "browser",
    "devtools",
    "mcp"
  ],
  "type": "module",
  "license": "MIT",
  "bin": {
    "chrome-cdp": "bin/chrome-cdp"
  },
  "scripts": {
    "test": "NODE_ENV=test vitest run",
    "lint": "eslint .",
    "check:docs": "node scripts/check-docs-contract.mjs",
    "check:command-surfaces": "node scripts/generate-command-surfaces.mjs",
    "check:host-validation": "node scripts/check-host-validation.mjs",
    "check:release-package": "node scripts/check-release-package.mjs",
    "check:contracts": "node scripts/check-public-contracts.mjs --version 2.15.0",
    "setup": "node scripts/setup.mjs",
    "smoke:live": "node scripts/live-smoke.mjs",
    "benchmark:killer": "node scripts/benchmark-killer-path.mjs",
    "benchmark:mcp": "node scripts/benchmark-mcp-path.mjs",
    "benchmark:cli": "node scripts/benchmark-mcp-path.mjs --route cli",
    "benchmark:campaign": "node scripts/benchmark-live-campaign.mjs",
    "benchmark:update-readme": "node scripts/update-readme-benchmark.mjs",
    "benchmark:generic-cdp": "node scripts/benchmark-generic-cdp-baseline.mjs",
    "benchmark:playwright": "node scripts/benchmark-playwright-baseline.mjs",
    "benchmark:baseline": "node scripts/benchmark-baseline-builder.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "vitest": "^3.2.6"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "INTEGRATIONS.md",
    "bin/",
    ".claude-plugin/",
    "docs/integrations/",
    "docs/schemas/",
    "docs/architecture/runtime-v3.md",
    "docs/adr/0001-runtime-v3-contract-first-strangler.md",
    "docs/contracts/",
    "docs/examples/killer-path.md",
    "docs/examples/codex-killer-path.md",
    "docs/benchmarks/host-validation.v1.json",
    "docs/benchmarks/measured-baselines.example.json",
    "docs/reference.md",
    "docs/browser-use-mapping.md",
    "docs/self-improvement-loop.md",
    "docs/strategy/agent-browser-vision.md",
    "experiment/codex-killer-path-demo-poster.png",
    "experiment/codex-killer-path-demo.html",
    "experiment/codex-killer-path-demo.mp4",
    "scripts/setup.mjs",
    "scripts/check-host-validation.mjs",
    "scripts/check-release-package.mjs",
    "scripts/check-public-contracts.mjs",
    "skills/"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  }
}
