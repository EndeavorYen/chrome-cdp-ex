{
  "name": "pi-chrome-cdp",
  "version": "2.21.0",
  "description": "Give your AI agent access to your live Chrome session — works out of the box, connects to tabs you already have open",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "skills",
    "chrome",
    "cdp",
    "browser",
    "devtools",
    "mcp"
  ],
  "type": "module",
  "license": "MIT",
  "bin": {
    "chrome-cdp": "bin/chrome-cdp"
  },
  "scripts": {
    "test": "node scripts/run-vitest.mjs",
    "lint": "eslint .",
    "check:docs": "node scripts/check-docs-contract.mjs",
    "check:changelog": "node scripts/changelog-fragments.mjs --check",
    "changelog:fold": "node scripts/changelog-fragments.mjs --fold",
    "check:next-allowlist": "node scripts/check-next-run-command.mjs",
    "check:command-surfaces": "node scripts/generate-command-surfaces.mjs",
    "check:release-package": "node scripts/changelog-fragments.mjs --release && node scripts/check-release-package.mjs",
    "setup": "node scripts/setup.mjs",
    "smoke:live": "node scripts/live-smoke.mjs",
    "usage:report": "node scripts/usage-report.mjs",
    "benchmark:slice1": "node scripts/benchmark-slice1.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^10.1.0",
    "espree": "^11.2.0",
    "globals": "^17.4.0",
    "vitest": "^3.2.6"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "INTEGRATIONS.md",
    "bin/",
    ".claude-plugin/",
    "docs/integrations/",
    "docs/schemas/",
    "docs/reference.md",
    "docs/daily-browser-cdp.md",
    "scripts/setup.mjs",
    "scripts/check-release-package.mjs",
    "skills/"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  }
}
